import React, { useState, useEffect, useRef } from "react";
import { motion } from "motion/react";
import {
  X,
  Send,
  Loader2,
  Paperclip,
  Zap,
  EyeOff,
  Link2,
  RefreshCw,
  UploadCloud,
  CloudSun,
  Sparkles,
  Inbox,
  Repeat,
  CalendarDays,
